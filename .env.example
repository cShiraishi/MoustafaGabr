# --- Google Scholar (publications) ---------------------------------------
# Scholar has no official public API. The site reads it through a provider
# chain: SerpAPI -> live scrape -> committed snapshot (data/scholar-snapshot.json).

# Scholar author id (the ?user= parameter of the profile URL)
NEXT_PUBLIC_SCHOLAR_ID=hw7IDDoAAAAJ

# Optional but recommended in production: https://serpapi.com (google_scholar_author engine)
SERPAPI_API_KEY=

# Set to "1" to allow the direct scrape fallback (works locally, often blocked
# from datacenter IPs such as Vercel/AWS).
SCHOLAR_ALLOW_SCRAPE=1

# Public site URL, used for metadata / sitemap
NEXT_PUBLIC_SITE_URL=https://moustafagabr.vercel.app
